# ============ Faso Équipement Paalga — réglages serveur (Apache) ============
ErrorDocument 404 /404.html
Options -Indexes

# Dossiers et fichiers techniques : jamais accessibles depuis le navigateur
RedirectMatch 404 ^/(src|config|node_modules)(/|$)
<FilesMatch "^(package(-lock)?\.json|tailwind\.config\.cjs|PLAN-DU-SITE\.md)$">
  Require all denied
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Mise en cache navigateur (meilleure vitesse = meilleur référencement)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
